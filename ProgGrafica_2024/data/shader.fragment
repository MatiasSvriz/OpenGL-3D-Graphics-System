#version 330

uniform sampler2D colorTexture;

struct Luz
{
    vec4 pos;
    vec4 color;
    float Ia;
    float Id;
    float Is;
    bool activa;
};

struct Material
{
    float ka;
    float kd;
    float ks;
    bool usaTextura;
    vec4 color;
    int shiny;
    float alpha;
};

struct Camara
{
    vec4 posicion;
};

uniform Luz luz;
uniform Material material;
uniform Camara camara;

in vec4 fColor;
in vec4 fPos;
in vec4 fNormal;
in vec4 fTextureCoords;

out vec4 FragColor;

void main()
{
    vec4 colorBase = material.color;

    if (material.usaTextura)
    {
        colorBase = texture(colorTexture, fTextureCoords.xy) * material.color;
    }
    else
    {
        colorBase = fColor * material.color;
    }

    if (!luz.activa)
    {
        FragColor = colorBase;
        FragColor.a = material.alpha * colorBase.a;
        return;
    }

    vec3 N = normalize(fNormal.xyz);
    vec3 L = normalize(luz.pos.xyz - fPos.xyz);
    vec3 V = normalize(camara.posicion.xyz - fPos.xyz);

    float ambiental = luz.Ia * material.ka;

    float factorDifuso = abs(dot(N, L));
    float difusa = luz.Id * material.kd * factorDifuso;

    float especular = 0.0;

    vec3 R = reflect(-L, N);
    float factorEspecular = max(dot(R, V), 0.0);
    especular = luz.Is * material.ks * pow(factorEspecular, material.shiny);

    float iluminacionTotal = ambiental + difusa + especular;

    // Mínimo de iluminación para que las zonas en sombra no queden negras.
    iluminacionTotal = clamp(iluminacionTotal, 0.15, 1.0);

    vec3 rgbFinal = colorBase.rgb * luz.color.rgb * iluminacionTotal;

    FragColor = vec4(rgbFinal, material.alpha * colorBase.a);
}